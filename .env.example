# Copy to .env and fill in. Never commit .env (secrets stay out of the repo, Q13 / I5.3).
# ── Core (P1) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amanat"
# Public HTTPS base URL with no trailing slash. Webhook signatures are checked against this exact URL.
# Locally: run `ngrok http 3000` and paste the https URL here.
APP_URL="http://localhost:3000"
# Any long random string. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-me-to-a-long-random-string"

# ── Worker (P2) ──
WORKER_TICK_MS=2000

# ── Integrations (P3) ──
# Twilio, Stripe and Telegram credentials are entered per workspace on /integrations (stored encrypted), not here.
# Google OAuth client (one per app, from Google Cloud console). Redirect URI: {APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Seconds before an unpaid Stripe checkout is shown as Abandoned (short for demos).
ABANDON_SECONDS=120
# Shows the fault-test lab to the Owner.
DEMO_MODE=true
