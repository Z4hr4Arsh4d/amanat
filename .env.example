DATABASE_URL=""
APP_URL="http://localhost:3000"
ENCRYPTION_KEY=""
# ── Notes and extra settings (append below; keep the lines above as they are) ──
# DATABASE_URL: e.g. postgresql://postgres:postgres@localhost:5432/amanat
# APP_URL: public HTTPS base URL with no trailing slash. Webhook signatures are checked against this exact URL.
#   Locally run `ngrok http 3000` and paste the https URL here.
# ENCRYPTION_KEY: any long random string, THE SAME for everyone sharing a database.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Worker (P2) ──
WORKER_TICK_MS=2000

# ── Integrations (P3) ──
# WhatsApp (Meta or Twilio), Stripe and Telegram credentials are entered per workspace on /integrations (stored encrypted), not here.
# Google OAuth client (one per app, from Google Cloud console). Redirect URI: {APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Seconds before an unpaid Stripe checkout is shown as Abandoned (short for demos).
ABANDON_SECONDS=120
# Shows the fault-test lab to the Owner.
DEMO_MODE=true
